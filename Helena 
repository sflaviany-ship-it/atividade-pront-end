    const photoInput = document.getElementById("memoryPhoto");
    const dateInput = document.getElementById("memoryDate");
    const descriptionInput = document.getElementById("memoryDescription");
    const moodInput = document.getElementById("memoryMood");
    const saveMemoryButton = document.getElementById("saveMemory");
    const memoriesContainer = document.getElementById("savedMemories");
    const emptyMemories = document.getElementById("emptyMemories");
    let selectedPhotoData = "";

    photoInput.addEventListener("change", () => {
      const file = photoInput.files && photoInput.files[0];
      if (!file) {
        selectedPhotoData = "";
        return;
      }
      if (!file.type.startsWith("image/")) {
        alert("Escolha um arquivo de imagem.");
        photoInput.value = "";
        return;
      }
      if (file.size > 2 * 1024 * 1024) {
        alert("Escolha uma foto de até 2 MB para não ocupar muito espaço.");
        photoInput.value = "";
        return;
      }
      const reader = new FileReader();
      reader.onload = () => { selectedPhotoData = String(reader.result || ""); };
      reader.readAsDataURL(file);
    });

    function loadMemories() {
      try {
        return JSON.parse(localStorage.getItem("ourLittleUniverseMemories") || "[]");
      } catch {
        return [];
      }
    }

    function saveMemories(memories) {
      try {
        localStorage.setItem("ourLittleUniverseMemories", JSON.stringify(memories));
        return true;
      } catch {
        alert("O navegador não conseguiu guardar esta memória. Tente uma foto menor ou remova algumas memórias antigas.");
        return false;
      }
    }

    function renderMemories() {
      const memories = loadMemories();
      memoriesContainer.innerHTML = "";
      if (!memories.length) {
        memoriesContainer.appendChild(emptyMemories);
        return;
      }
      memories.forEach((memory, index) => {
        const card = document.createElement("article");
        card.className = "saved-memory";
        if (memory.photo) {
          const img = document.createElement("img");
          img.src = memory.photo;
          img.alt = "Foto de uma memória";
          card.appendChild(img);
        }
        const body = document.createElement("div");
        body.className = "saved-memory-body";
        const date = document.createElement("div");
        date.className = "saved-memory-date";
        date.textContent = memory.date || "Uma data especial";
        const description = document.createElement("p");
        description.textContent = memory.description;
        const mood = document.createElement("div");
        mood.className = "saved-memory-mood";
        mood.textContent = memory.mood;
        const remove = document.createElement("button");
        remove.className = "remove-memory";
        remove.textContent = "Apagar esta memória";
        remove.addEventListener("click", () => {
          const updated = loadMemories();
          updated.splice(index, 1);
          if (saveMemories(updated)) renderMemories();
        });
        body.append(date, description, mood, remove);
        card.appendChild(body);
        memoriesContainer.appendChild(card);
      });
    }

    saveMemoryButton.addEventListener("click", () => {
      const description = descriptionInput.value.trim();
      if (!description) {
        alert("Escreva uma pequena descrição para esta memória.");
        descriptionInput.focus();
        return;
      }
      const memories = loadMemories();
      memories.unshift({
        photo: selectedPhotoData,
        date: dateInput.value,
        description,
        mood: moodInput.value
      });
      if (saveMemories(memories)) {
        descriptionInput.value = "";
        dateInput.value = "";
        moodInput.value = "🥰 Feliz";
        photoInput.value = "";
        selectedPhotoData = "";
        renderMemories();
      }
    });

    renderMemories();
  </script>
